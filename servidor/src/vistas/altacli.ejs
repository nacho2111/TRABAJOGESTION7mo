<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alta Cliente</title>
</head>

<body>
    <h1>ALTA DE CLIENTES</h1>
    <form action="POST /nuevocli" method="POST">
        <input name="numcuit" type="text" placeholder="CUIT" maxlength="8" size="15">
        <input name="nomcli" type="text" placeholder="Nombre" maxlength="8" size="15">
        <input name="dircli" type="text" placeholder="Dirección" maxlength="8" size="15">
        <input name="telcli" type="text" placeholder="Teléfono" maxlength="8" size="15">
        <button>Registrar</button>
    </form>
</body>

</html>